DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentic_platform

# Gemini is the only LLM provider this deployment runs -
# app/llm/factory.py::get_llm_client() rejects any other LLM_PROVIDER value
# with a clear error. Key name only below - never commit a real key, never
# hardcode one in code. Leaving GEMINI_API_KEY blank is a fully supported
# mode, not a broken one: every corruption escalates to human review and
# reports generate from the deterministic template instead of failing -
# see README's "Running without an LLM" section.
LLM_PROVIDER=gemini

# AI Studio developer API key, NOT a Vertex AI / GCP service account -
# Vertex requires a billing account. GEMINI_MODEL must be on the free-tier
# allowlist in app/llm/gemini_client.py (gemini-3.5-flash,
# gemini-3.5-flash-lite); anything else is rejected at construction time.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: GEMINI_API_KEYS (plural, comma-separated) instead of the single
# GEMINI_API_KEY above, e.g. GEMINI_API_KEYS=key-one,key-two,key-three.
# Each free-tier key/project gets its OWN separate quota
# (GenerateRequestsPerDayPerProjectPerModel-FreeTier, 20/day per model as of
# this writing) - a second key is real extra headroom, not a workaround.
# app/llm/gemini_client.py::GeminiClient rotates to the next key on a 429
# automatically and retries the same request; it only raises once every
# configured key is exhausted. If both GEMINI_API_KEYS and GEMINI_API_KEY
# are set, GEMINI_API_KEYS wins.
GEMINI_API_KEYS=

# Where diagnoses are cached on disk, keyed by (rule, column, detail) across
# every event in a correlated group. Deleting this file just means the next
# matching failure re-spends one LLM call.
DIAGNOSIS_CACHE_PATH=.cache/diagnoses.json

# Same pattern as DIAGNOSIS_CACHE_PATH, for the Query Agent (Phase 6) and
# Modeling Agent (Phase 7) generation caches - keyed on
# (provider, model, schema hash, normalized question).
QUERY_CACHE_PATH=.cache/queries.json
MODELING_CACHE_PATH=.cache/modeling.json

# The gate's auto-apply confidence threshold (app/gate.py). Diagnosis
# itself is threshold-independent; this only decides which side of
# auto-apply/escalate a diagnosis lands on. See README's Phase 2 notes for
# why this is a coarse gate, not a calibrated probability cutoff.
GATE_CONFIDENCE_THRESHOLD=0.8

# How many levels deep app/resolution.py::process_queue will chase a fix
# that reveals another previously-not_applicable rule before escalating
# the rest without diagnosing them further (see Run.reveal_depth_reached).
REVEAL_DEPTH_CAP=2

# Where a run's raw pre-fix frame is snapshotted to Parquet once it's known
# to be pausing at awaiting_approval against a mutable (SQL/API) source -
# see app/run_snapshots.py's module docstring. Must be a path the app
# container can write to and that SURVIVES a container restart (a human
# approval can arrive days later) - docker-compose.yml mounts this to a
# named volume for exactly that reason.
RUN_ARTIFACTS_DIR=.run_artifacts

# Where a file uploaded via the dashboard's Sources screen (POST /sources/upload)
# is saved before being registered as a `file` source - app/routers/sources.py
# reuses FileConnector unchanged, exactly as if that path had been typed into
# the manual connection_config form. docker-compose.yml points this at
# /data/uploads, inside the SAME ./data volume the manual-path flow already
# uses, so an uploaded file is visible on the host too.
UPLOAD_DIR=data/uploads

# Phase 8: where the LangGraph ingest orchestrator's checkpoints live -
# what makes a run halted at await_human resumable after a process
# restart, not just within one. Set GRAPH_CHECKPOINT_POSTGRES_URL to use
# the same Postgres instance as DATABASE_URL (recommended for
# docker-compose / production: one durable store, one backup story, no
# separate volume to manage). If unset, GRAPH_CHECKPOINT_PATH (a local
# SQLite file) is used instead - fine for `uvicorn --reload` local
# development, not recommended once more than one app process/replica
# could be handling requests for the same run.
GRAPH_CHECKPOINT_POSTGRES_URL=
GRAPH_CHECKPOINT_PATH=.cache/graph_checkpoints.db

